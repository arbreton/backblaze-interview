# Copy to .env and fill in. See docs/B2_SETUP.md for how to get these values.

# --- Backblaze B2 (S3-compatible API) ---
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
# Shown on the bucket page as "Endpoint", e.g. s3.us-west-004.backblazeb2.com
B2_ENDPOINT=
# Optional key prefix inside the bucket
B2_PREFIX=uploads/

# --- Claude ---
# The key is read from this file at runtime (never copied into the repo).
# ANTHROPIC_API_KEY in the environment takes precedence if set.
CLAUDE_KEY_FILE=~/Desktop/claudekey.txt
CLAUDE_MODEL=claude-opus-5-5

# --- Service ---
MAX_UPLOAD_MB=50
# The "local path" endpoint can read files on this machine. Restrict it to a folder.
LOCAL_PATH_ROOT=~/Desktop
